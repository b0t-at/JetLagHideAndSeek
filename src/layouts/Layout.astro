---
import "@/styles/fonts.css";
import "@/styles/globals.css";
import { ToastContainer } from "react-toastify";
// @ts-ignore
import { pwaInfo } from "virtual:pwa-info";

export interface Props {
    className?: string;
}

const { className } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/x-icon"
            href="https://b0t-at.github.io/JetLagHideAndSeek/favicon.ico"
        />
        <link
            rel="shortcut icon"
            type="image/x-icon"
            href="https://b0t-at.github.io/JetLagHideAndSeek/favicon.ico"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="https://b0t-at.github.io/JetLagHideAndSeek/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="https://b0t-at.github.io/JetLagHideAndSeek/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="https://b0t-at.github.io/JetLagHideAndSeek/favicon-16x16.png"
        />
        <meta name="generator" content={Astro.generator} />
        <!-- HTML Meta Tags -->
        <title>Map Generator for Jet Lag The Game: Hide and Seek</title>
        <meta
            name="description"
            content="Automatically generate maps for Jet Lag The Game: Hide and Seek with ease! Simply name the questions and watch the map eliminate hundreds of possibilities in seconds."
        />

        <!-- Facebook Meta Tags -->
        <meta
            property="og:url"
            content="https://b0t-at.github.io/JetLagHideAndSeek/"
        />
        <meta property="og:type" content="website" />
        <meta
            property="og:title"
            content="Map Generator for Jet Lag The Game: Hide and Seek"
        />
        <meta
            property="og:description"
            content="Automatically generate maps for Jet Lag The Game: Hide and Seek with ease! Simply name the questions and watch the map eliminate hundreds of possibilities in seconds."
        />
        <meta
            property="og:image"
            content="https://b0t-at.github.io/JetLagHideAndSeek/JLIcon.png"
        />

        <!-- Twitter Meta Tags -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:domain" content="b0t-at.github.io/JetLagHideAndSeek" />
        <meta
            property="twitter:url"
            content="https://b0t-at.github.io/JetLagHideAndSeek/"
        />
        <meta
            name="twitter:title"
            content="Map Generator for Jet Lag The Game: Hide and Seek"
        />
        <meta
            name="twitter:description"
            content="Automatically generate maps for Jet Lag The Game: Hide and Seek with ease! Simply name the questions and watch the map eliminate hundreds of possibilities in seconds."
        />
        <meta
            name="twitter:image"
            content="https://b0t-at.github.io/JetLagHideAndSeek/JLIcon.png"
        />

        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    </head>
    <body class:list={[className, "dark"]}>
        <slot />
        <ToastContainer client:only />
        <script>
            import "../pwa.ts";
        </script>
    </body>
</html>
